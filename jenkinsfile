pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                echo 'Git checkout...'
                git branch: 'cicdbranchjenkins', url: 'https://github.com/akhilkumar0024/java11-examples.git'
            }
        }
        stage('Validate, Compile, Test, Package& Verify') {
            steps {
                echo 'Building...'
                sh 'mvn clean verify'
            }
        }
    }
}
